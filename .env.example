# ManaGame — environment variables
# The app runs fully without any of these set (see README "Runs out of the
# box" section) — each one is a progressive-enhancement upgrade.

# Optional. A standard Postgres connection string (works with Supabase, Neon,
# Vercel Postgres, RDS, or any Postgres — no vendor SDK is required). When
# unset, the app uses an in-process store so it still runs end-to-end.
# After setting this, run: npm run db:migrate
DATABASE_URL=

# Optional. Enables LLM-assisted decision parsing (Claude) instead of the
# deterministic heuristic keyword matcher, AND switches the candidate turn UI
# to the conversational agent (chat + direct AI scoring) instead of the
# composer-only flow. See README "Connecting an LLM" for details.
ANTHROPIC_API_KEY=

# Optional. A Make.com "Custom webhook" URL — when set, ManaGame POSTs a
# small JSON event to it on session completion and whenever a decision is
# flagged for human review. Routing (email/Slack/CRM/etc.) is configured
# entirely inside the Make scenario, not here. See README "Connecting Make".
MAKE_WEBHOOK_URL=

# Optional. Overrides the base URL used to build links back into ManaGame in
# outbound notifications (e.g. the Make webhook payload's reportUrl). Falls
# back to Vercel's per-deployment URL, then to the canonical production
# domain — see lib/integrations/make-webhook.ts.
NEXT_PUBLIC_SITE_URL=
