# ManaGame — environment variables
# The app runs fully without any of these set (see README "Runs out of the
# box" section) — each one is a progressive-enhancement upgrade.

# Optional. A standard Postgres connection string (works with Supabase, Neon,
# Vercel Postgres, RDS, or any Postgres — no vendor SDK is required). When
# unset, the app uses an in-process store so it still runs end-to-end.
# After setting this, run: npm run db:migrate
DATABASE_URL=

# Optional. Enables LLM-assisted decision parsing (Claude) instead of the
# deterministic heuristic keyword matcher, AND switches the candidate turn UI
# to the conversational agent (chat + direct AI scoring) instead of the
# composer-only flow. See README "Connecting an LLM" for details.
ANTHROPIC_API_KEY=

# Optional. A Make.com "Custom webhook" URL — when set, ManaGame POSTs a
# small JSON event to it on session completion and whenever a decision is
# flagged for human review. Routing (email/Slack/CRM/etc.) is configured
# entirely inside the Make scenario, not here. See README "Connecting Make".
MAKE_WEBHOOK_URL=

# Optional. Overrides the base URL used to build links back into ManaGame in
# outbound notifications (e.g. the Make webhook payload's reportUrl). Falls
# back to Vercel's per-deployment URL, then to the canonical production
# domain — see lib/integrations/make-webhook.ts.
NEXT_PUBLIC_SITE_URL=

# Optional but recommended once real candidates are using the no-database
# mode. Signs the resiliency-layer session cookie (lib/session-cache.ts) so
# a candidate can't edit it (devtools/curl) to forge their own KPI state or
# turn progress. Without it, falls back to Vercel's per-deployment commit
# SHA (still safe, just rotates on every deploy) and finally a fixed
# local-dev-only string. See lib/session-cookie-sign.ts.
SESSION_COOKIE_SECRET=

# Optional but REQUIRED before real candidates use the system. When set, it
# turns on the access gate in proxy.ts: /admin and /assessor require this
# passphrase and issue a signed 12-hour session cookie. When unset the gate is
# off (so local dev and the current deployment keep working) and every internal
# page shows a standing warning that candidate reports are publicly readable.
# See lib/auth/admin-session.ts and docs/personal-data-map.md.
ADMIN_PASSWORD=

# Optional. Enables the read-only integration API at /api/v1 for pulling
# assessment outcomes into an ATS. With no token set the API returns 503 —
# it is off, not merely unauthenticated. Deliberately separate from
# ADMIN_PASSWORD: a machine credential and a human session should not share
# a secret. See docs/integration-api.md.
ATS_API_TOKEN=
